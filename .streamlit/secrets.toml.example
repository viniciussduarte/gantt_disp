# Exemplo de configuração de conexão permanente com o Supabase (PostgreSQL)
# 
# Como usar localmente:
# 1. Crie uma cópia deste arquivo chamada secrets.toml dentro da pasta .streamlit/
# 2. Cole a URI de conexão do seu projeto Supabase no campo DATABASE_URL abaixo.
#
# Como usar no Streamlit Community Cloud:
# 1. Acesse o painel do seu app em share.streamlit.io
# 2. Vá em Settings -> Secrets
# 3. Cole a linha abaixo substituindo com a sua URL e salve.

DATABASE_URL = "postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA]@aws-0-[SUA_REGIAO].pooler.supabase.com:6543/postgres"
