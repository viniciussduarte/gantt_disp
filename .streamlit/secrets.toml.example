# Configuração de conexão com o Supabase (PostgreSQL)
#
# IMPORTANTE para Streamlit Community Cloud:
# O Streamlit Cloud (AWS) não suporta conexões de saída IPv6. Por isso, a conexão direta
# (db.<ref>.supabase.co:5432) falha e o sistema faz fallback para SQLite local.
# Para conectar na nuvem, utilize SEMPRE o Connection Pooler IPv4 (porta 6543 ou 5432):
#
# DATABASE_URL = "postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres"
#
# Exemplo para este projeto (região us-east-2):
# DATABASE_URL = "postgresql://postgres.dzotqvnlwhbrbosgxgwe:[SENHA]@aws-0-us-east-2.pooler.supabase.com:6543/postgres"
